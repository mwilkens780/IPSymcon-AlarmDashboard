{
  "elements": [
    {
      "type": "List",
      "name": "statusItems",
      "caption": "Statuspunkte",
      "rowCount": 8,
      "add": true,
      "delete": true,
      "columns": [
        { "caption": "Name", "name": "name", "width": "180px", "add": "", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Variable", "name": "variable", "width": "200px", "add": 0, "edit": { "type": "SelectVariable" } },
        {
          "caption": "Typ",
          "name": "type",
          "width": "160px",
          "add": "text",
          "edit": {
            "type": "Select",
            "options": [
              { "caption": "Scharf/Unscharf (schaltbar)", "value": "arm" },
              { "caption": "Sirene (schaltbar)", "value": "siren" },
              { "caption": "Alarm (Ja/Nein)", "value": "alarm" },
              { "caption": "Fenster/Tür (Auf/Zu)", "value": "window" },
              { "caption": "Zeitstempel", "value": "timestamp" },
              { "caption": "Text", "value": "text" }
            ]
          }
        }
      ],
      "values": []
    },
    {
      "type": "Label",
      "caption": "Beliebige Variablen, z.B. die per 'HomeMatic Systemvariablen'-Instanz aus der CCU3 gespiegelten Alarm-Systemvariablen. 'Scharf/Unscharf' (für 'Alarm intern'/'Alarm extern') ist ein Schalter, der direkt auf die CCU3 zurückschreibt. 'Sirene' ist ein Schalter fuer z.B. ACOUSTIC_ALARM_ACTIVE/OPTICAL_ALARM_ACTIVE einer HomeMatic-Sirene (Ausschalten stoppt Ton/Blitz sofort). 'Alarm' zeigt bei 'Ein' einen roten ALARM-Badge und löst den Alarm-Banner oben aus; 'Fenster/Tür' zeigt nur Auf/Zu ohne Alarm-Banner."
    },
    {
      "type": "SelectInstance",
      "name": "battery_monitor",
      "caption": "Batterie-Monitor (optional)"
    },
    {
      "type": "Label",
      "caption": "Eine ProfileMonitor-Instanz mit den Datenpunkten 'Warning' und 'Devices_With_Empty_Battery'."
    },
    {
      "type": "NumberSpinner",
      "name": "update_interval",
      "caption": "Aktualisierungsintervall (Sekunden)",
      "minimum": 10,
      "suffix": "s"
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt aktualisieren",
      "onClick": "ALD_Refresh($id);"
    }
  ],
  "status": [
    { "code": 102, "icon": "active",   "caption": "Aktiv" },
    { "code": 200, "icon": "error",    "caption": "Fehler – Details im IPS-Log" },
    { "code": 201, "icon": "inactive", "caption": "Nicht konfiguriert – mindestens einen Statuspunkt oder den Batterie-Monitor hinzufügen" }
  ]
}
